import SwiftUI

// MARK: - SwiftUI.Image

{% macro casesBlock assets %}
{%- for asset in assets %}
{%- if asset.type == "image" %}
{{accessModifier}} static let {{asset.name|swiftIdentifier:"pretty"|lowerFirstWord|escapeReservedKeywords}} = Image("{{asset.value}}", bundle: .module)
{%- elif asset.items and ( forceNamespaces == "true" or asset.isNamespaced == "true" ) %}
{{accessModifier}} enum {{asset.name|swiftIdentifier:"pretty"|escapeReservedKeywords}} {
    {% filter indent:4," ",true %}{% call casesBlock asset.items %}{% endfilter %}
}
{%- elif asset.items %}
{%- call casesBlock asset.items %}
{%- endif %}
{%- endfor %}
{%- endmacro %}
extension SwiftUI.Image {
    {% filter indent:4," ",true %}{% call casesBlock catalogs.first.assets %}{% endfilter %}
}

